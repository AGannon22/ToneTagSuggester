{
  "name": "Tone Tag Suggester Chrome Extension",
  "description": "Generate tone tags for your messages!",
  "version": "2.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_icon": "ToneTag_Suggester_Logo.png"
  },
  "permissions": ["activeTab","scripting","storage","privacy"],
    "host_permissions": ["http://localhost:8000/*"]

}
